  "acceptance": {
    "max_paid_ece": 0.05,
    "max_abs_writeoff_gap365": 0.03,
    "max_short_paid_brier_ratio": 1.02
  },
  "bootstrap": {
    "replicates": 400,
    "unit": "company within World; no CI claim over unseen economies"
  },
  "industry_missing_sensitivity": "after selection freeze, mask all industry; report only, no reselection",
