{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "score_meaning", "feature_contract_fingerprint", "row_count", "rows"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": "method-output/1.0.0"},
    "score_meaning": {"type": "string"},
    "feature_contract_fingerprint": {"type": "string"},
    "row_count": {"type": "integer", "minimum": 0},
    "snapshot": {"type": "object"},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "reason": {"type": "object", "required": ["code", "message"], "additionalProperties": false,
      "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}},
    "method": {
      "type": "object", "additionalProperties": false,
      "required": ["method_id", "raw_score", "score", "score_kind", "available", "reason", "missing_features", "artifact_id", "preprocess_version", "reference_version", "feature_contract_fingerprint", "evidence_refs", "details"],
      "properties": {
        "method_id": {"type": "string"}, "raw_score": {"type": ["number", "null"]},
        "score": {"type": ["number", "null"]}, "score_kind": {"enum": ["rule_points", "empirical_midrank"]},
        "available": {"type": "boolean"}, "reason": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reason"}]},
        "missing_features": {"type": "array", "items": {"type": "string"}},
        "artifact_id": {"type": ["string", "null"]}, "reference_version": {"type": ["string", "null"]},
        "preprocess_version": {"type": ["string", "null"]},
        "feature_contract_fingerprint": {"type": "string"}, "evidence_refs": {"type": "array", "items": {"type": "object"}},
        "details": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"available": {"const": true}}},
         "then": {"properties": {"raw_score": {"type": "number"}, "score": {"type": "number"}, "reason": {"type": "null"}}},
         "else": {"properties": {"raw_score": {"type": "null"}, "score": {"type": "null"}, "reason": {"$ref": "#/$defs/reason"}}}},
        {"if": {"properties": {"score_kind": {"const": "empirical_midrank"}, "available": {"const": true}}},
         "then": {"properties": {"score": {"minimum": 0, "maximum": 1}}}}
      ]
    },
    "graph": {
      "type": "object", "additionalProperties": false,
      "required": ["available", "reason", "nodes", "links", "findings", "information_gaps", "evidence_refs"],
      "properties": {
        "available": {"type": "boolean"}, "reason": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/reason"}]},
        "nodes": {"type": "array"}, "links": {"type": "array"}, "findings": {"type": "array"},
        "information_gaps": {"type": "array"}, "evidence_refs": {"type": "array"}, "scope": {"type": "object"}
      },
      "allOf": [{"if": {"properties": {"available": {"const": true}}},
        "then": {"properties": {"reason": {"type": "null"}}},
        "else": {"properties": {"reason": {"$ref": "#/$defs/reason"}}}}]
    },
    "row": {
      "type": "object", "additionalProperties": false,
      "required": ["row_index", "tenant_id", "company_id", "record_id", "revision", "event_at", "as_of", "methods", "graph"],
      "properties": {
        "row_index": {"type": "integer", "minimum": 0}, "tenant_id": {"type": "string"},
        "company_id": {"type": "string"}, "record_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1}, "event_at": {"type": "string"}, "as_of": {"type": "string"},
        "methods": {"type": "object", "required": ["rules"], "additionalProperties": {"$ref": "#/$defs/method"}},
        "graph": {"$ref": "#/$defs/graph"}
      }
    }
  }
}
