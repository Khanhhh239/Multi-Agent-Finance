{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "spec_version",
    "stage",
    "run_id",
    "tests"
  ],
  "properties": {
    "spec_version": {
      "const": "2.1"
    },
    "stage": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "expected",
          "observed",
          "evidence_path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-6]-[0-9]+$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked"
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "evidence_path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}