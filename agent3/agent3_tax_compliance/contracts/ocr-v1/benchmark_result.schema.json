{
  "$defs": {
    "Detection": {
      "additionalProperties": false,
      "properties": {
        "polygon": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 64,
          "minItems": 3,
          "title": "Polygon",
          "type": "array"
        },
        "text_raw": {
          "maxLength": 200000,
          "title": "Text Raw",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "block_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Type"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        }
      },
      "required": [
        "polygon",
        "text_raw"
      ],
      "title": "Detection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "output_mode": {
      "enum": [
        "boxes_and_text",
        "full_page_text",
        "structured_document"
      ],
      "title": "Output Mode",
      "type": "string"
    },
    "image_id": {
      "title": "Image Id",
      "type": "string"
    },
    "image_width": {
      "exclusiveMinimum": 0,
      "title": "Image Width",
      "type": "integer"
    },
    "image_height": {
      "exclusiveMinimum": 0,
      "title": "Image Height",
      "type": "integer"
    },
    "load_time_ms": {
      "minimum": 0,
      "title": "Load Time Ms",
      "type": "number"
    },
    "inference_time_ms": {
      "minimum": 0,
      "title": "Inference Time Ms",
      "type": "number"
    },
    "document_text_raw": {
      "default": "",
      "maxLength": 200000,
      "title": "Document Text Raw",
      "type": "string"
    },
    "detections": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Detection"
      },
      "maxItems": 20000,
      "title": "Detections",
      "type": "array"
    },
    "structured_blocks": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Structured Blocks",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "metadata": {
      "additionalProperties": true,
      "default": {},
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "model_id",
    "output_mode",
    "image_id",
    "image_width",
    "image_height",
    "load_time_ms",
    "inference_time_ms"
  ],
  "title": "BenchmarkResult",
  "type": "object"
}
