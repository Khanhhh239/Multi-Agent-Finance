    "OCRConfig": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "default": "tesseract-v1-psm3",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
