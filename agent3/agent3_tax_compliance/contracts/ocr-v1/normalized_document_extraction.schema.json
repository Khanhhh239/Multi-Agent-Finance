    "NormalizedPageExtraction": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "config_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Config Version",
          "type": "string"
        },
        "creator": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Creator",
          "type": "string"
        },
        "stage": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Stage",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "page_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Page Id",
          "type": "string"
        },
        "page_index": {
          "minimum": 0,
          "title": "Page Index",
          "type": "integer"
        },
        "image_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Image Hash",
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "route": {
          "enum": [
            "NATIVE_TEXT",
            "OCR",
            "HYBRID",
            "UNSUPPORTED"
          ],
          "title": "Route",
          "type": "string"
        },
        "status": {
          "enum": [
            "COMPLETE",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "blocks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExtractionBlock"
          },
          "title": "Blocks",
          "type": "array"
        },
        "raw_responses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OCRBridgeResponse"
          },
          "title": "Raw Responses",
          "type": "array"
        },
        "table_candidates": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Table Candidates",
          "type": "array"
        },
        "issue": {
          "anyOf": [
            {
              "$ref": "#/$defs/OCRIssue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "config_version",
        "creator",
        "stage",
        "page_id",
        "page_index",
        "image_hash",
        "geometry",
        "route",
        "status"
      ],
      "title": "NormalizedPageExtraction",
      "type": "object"
    },
