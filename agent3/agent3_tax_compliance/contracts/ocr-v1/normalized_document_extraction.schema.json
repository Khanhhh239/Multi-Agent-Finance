        "polygon": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "maxItems": 64,
              "minItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "block_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Type"
        },
        "reading_order": {
          "minimum": 0,
          "title": "Reading Order",
          "type": "integer"
        },
        "origins": {
          "items": {
            "$ref": "#/$defs/BlockOrigin"
          },
          "minItems": 1,
          "title": "Origins",
          "type": "array"
        },
        "conflict_with": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Conflict With",
          "type": "array"
        }
      },
      "required": [
        "block_id",
        "text_raw",
        "geometry_status",
        "reading_order",
        "origins"
      ],
      "title": "ExtractionBlock",
      "type": "object"
    },
