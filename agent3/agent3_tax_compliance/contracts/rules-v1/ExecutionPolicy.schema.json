{
  "additionalProperties": false,
  "properties": {
    "version": {
      "default": "zen-execution-v1",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Version",
      "type": "string"
    },
    "timeout_seconds": {
      "default": 10,
      "exclusiveMinimum": 0,
      "maximum": 60,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "memory_mb": {
      "default": 256,
      "maximum": 1024,
      "minimum": 64,
      "title": "Memory Mb",
      "type": "integer"
    },
    "max_attempts": {
      "default": 2,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "max_units": {
      "default": 1000,
      "maximum": 10000,
      "minimum": 1,
      "title": "Max Units",
      "type": "integer"
    },
    "max_response_bytes": {
      "default": 2000000,
      "maximum": 16000000,
      "minimum": 1024,
      "title": "Max Response Bytes",
      "type": "integer"
    }
  },
  "title": "ExecutionPolicy",
  "type": "object"
}
