{
  "additionalProperties": false,
  "properties": {
    "transform_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Transform Id",
      "type": "string"
    },
    "source_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Source Id",
      "type": "string"
    },
    "page_index": {
      "minimum": 0,
      "title": "Page Index",
      "type": "integer"
    },
    "from_space": {
      "enum": [
        "PDF_POINTS",
        "IMAGE_PIXELS"
      ],
      "title": "From Space",
      "type": "string"
    },
    "to_space": {
      "const": "NORMALIZED_TOP_LEFT",
      "default": "NORMALIZED_TOP_LEFT",
      "title": "To Space",
      "type": "string"
    },
    "source_width": {
      "exclusiveMinimum": 0,
      "title": "Source Width",
      "type": "number"
    },
    "source_height": {
      "exclusiveMinimum": 0,
      "title": "Source Height",
      "type": "number"
    },
    "matrix": {
      "maxItems": 6,
      "minItems": 6,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Matrix",
      "type": "array"
    }
  },
  "required": [
    "transform_id",
    "source_id",
    "page_index",
    "from_space",
    "source_width",
    "source_height",
    "matrix"
  ],
  "title": "PageTransform",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financial:capture:1.0.0:page_transform"
}
