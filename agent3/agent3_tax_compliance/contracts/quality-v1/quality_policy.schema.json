{
  "$defs": {
    "QualityProfile": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Version",
          "type": "string"
        },
        "record_type": {
          "enum": [
            "INVOICE",
            "RECEIPT"
          ],
          "title": "Record Type",
          "type": "string"
        },
        "expected_fields": {
          "items": {
            "type": "string"
          },
          "title": "Expected Fields",
          "type": "array"
        },
        "critical_fields": {
          "items": {
            "type": "string"
          },
          "title": "Critical Fields",
          "type": "array"
        },
        "item_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Item Fields",
          "type": "array"
        }
      },
      "required": [
        "version",
        "record_type",
        "expected_fields",
        "critical_fields"
      ],
      "title": "QualityProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Version",
      "type": "string"
    },
    "auto_accept_enabled": {
      "const": false,
      "default": false,
      "title": "Auto Accept Enabled",
      "type": "boolean"
    },
    "threshold_status": {
      "const": "TBD_INSUFFICIENT_DATA",
      "default": "TBD_INSUFFICIENT_DATA",
      "title": "Threshold Status",
      "type": "string"
    },
    "threshold_owner": {
      "title": "Threshold Owner",
      "type": "string"
    },
    "thresholds": {
      "additionalProperties": {
        "anyOf": [
          {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Thresholds",
      "type": "object"
    },
    "fidelity_policies": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Fidelity Policies",
      "type": "array"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/QualityProfile"
      },
      "title": "Profiles",
      "type": "array"
    }
  },
  "required": [
    "version",
    "threshold_owner",
    "thresholds",
    "profiles"
  ],
  "title": "QualityPolicy",
  "type": "object"
}
