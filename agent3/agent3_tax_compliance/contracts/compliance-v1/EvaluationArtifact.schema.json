        "transform_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transform Id"
        }
      },
      "required": [
        "source_id",
        "document_id",
        "page_index",
        "bbox"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExecutionError": {
