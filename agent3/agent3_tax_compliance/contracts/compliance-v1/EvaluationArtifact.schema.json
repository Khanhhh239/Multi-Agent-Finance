{
  "$defs": {
    "Aggregate": {
      "additionalProperties": false,
      "properties": {
        "processing_status": {
          "enum": [
            "SUCCESS",
            "PARTIAL_ERROR",
            "ERROR"
          ],
          "title": "Processing Status",
          "type": "string"
        },
        "coverage": {
          "enum": [
            "FULL",
            "PARTIAL",
            "NONE"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "PASS",
                "PASS_WITHIN_SCOPE",
                "FAIL",
                "REVIEW",
                "NO_VERDICT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verdict"
        },
        "review_required": {
          "title": "Review Required",
          "type": "boolean"
        },
        "counts": {
          "$ref": "#/$defs/UnitCounts"
        },
        "distinct_rules_selected": {
          "minimum": 0,
          "title": "Distinct Rules Selected",
          "type": "integer"
        },
        "distinct_rules_evaluated": {
          "minimum": 0,
          "title": "Distinct Rules Evaluated",
          "type": "integer"
        },
        "scope_exclusions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnitIssue"
          },
          "title": "Scope Exclusions",
          "type": "array"
        },
        "blocked_units": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnitIssue"
          },
          "title": "Blocked Units",
          "type": "array"
        },
        "operational_errors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnitIssue"
          },
          "title": "Operational Errors",
          "type": "array"
        },
        "unresolved": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnitIssue"
          },
          "title": "Unresolved",
          "type": "array"
        },
        "discovery_blockers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnitIssue"
          },
          "title": "Discovery Blockers",
          "type": "array"
        },
        "contract_errors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Contract Errors",
          "type": "array"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "processing_status",
        "coverage",
        "verdict",
        "review_required",
        "counts",
        "distinct_rules_selected",
        "distinct_rules_evaluated",
        "reasons"
      ],
      "title": "Aggregate",
      "type": "object"
    },
    "ConditionTrace": {
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Condition Id",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        },
        "origin": {
          "const": "ADAPTER",
          "default": "ADAPTER",
          "title": "Origin",
          "type": "string"
        },
        "policy_version": {
          "const": "decimal-facts-v1",
          "default": "decimal-facts-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "field_paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Field Paths",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "observed_json": {
          "title": "Observed Json",
          "type": "string"
        },
        "expected_json": {
          "title": "Expected Json",
          "type": "string"
        }
      },
      "required": [
        "condition_id",
        "value",
        "field_paths",
        "evidence_refs",
        "observed_json",
        "expected_json"
      ],
      "title": "ConditionTrace",
      "type": "object"
    },
    "EvaluationKey": {
      "additionalProperties": false,
      "properties": {
        "evaluation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Evaluation Id",
          "type": "string"
        },
        "record_revision": {
          "minimum": 1,
          "title": "Record Revision",
          "type": "integer"
        },
        "rule_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Rule Version",
          "type": "string"
        },
        "unit_type": {
          "enum": [
            "RECORD",
            "ITEM",
            "VAT_GROUP"
          ],
          "title": "Unit Type",
          "type": "string"
