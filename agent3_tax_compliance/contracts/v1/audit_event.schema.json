{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "config_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Config Version",
      "type": "string"
    },
    "creator": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Creator",
      "type": "string"
    },
    "stage": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Stage",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Event Id",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "taxpayer_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Taxpayer Id",
      "type": "string"
    },
    "actor_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Actor Id",
      "type": "string"
    },
    "record_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Record Id"
    },
    "record_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Record Revision"
    },
    "event_type": {
      "enum": [
        "TAXPAYER_STORED",
        "SOURCE_STORED",
        "RECORD_CREATED",
        "RECORD_REVISED",
        "ARTIFACT_STORED",
        "JOB_CREATED"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "config_version",
    "creator",
    "stage",
    "event_id",
    "tenant_id",
    "taxpayer_id",
    "actor_id",
    "event_type",
    "input_sha256",
    "reason"
  ],
  "title": "AuditEvent",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:financial:capture:1.0.0:audit_event"
}
