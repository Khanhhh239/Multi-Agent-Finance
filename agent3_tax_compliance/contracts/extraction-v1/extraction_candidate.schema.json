{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Source Id",
          "type": "string"
        },
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Document Id",
          "type": "string"
        },
        "page_index": {
          "minimum": 0,
          "title": "Page Index",
          "type": "integer"
        },
        "coordinate_system": {
          "const": "NORMALIZED_TOP_LEFT",
          "default": "NORMALIZED_TOP_LEFT",
          "title": "Coordinate System",
          "type": "string"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "block_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "minimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span"
        },
        "transform_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transform Id"
        }
      },
      "required": [
        "source_id",
        "document_id",
        "page_index",
        "bbox"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "RawScore": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Block Id",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "semantics": {
          "enum": [
            "ENGINE_HEURISTIC_NOT_CALIBRATED",
            "UNAVAILABLE"
          ],
          "title": "Semantics",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "value",
        "kind",
        "semantics"
      ],
      "title": "RawScore",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Candidate Id",
      "type": "string"
    },
    "semantic_field": {
      "title": "Semantic Field",
      "type": "string"
    },
    "raw_value": {
      "title": "Raw Value",
      "type": "string"
    },
    "normalized_value": {
      "title": "Normalized Value",
      "type": "string"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "block_refs": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "title": "Block Refs",
      "type": "array"
    },
    "method_version": {
      "default": "label-region-v1",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Method Version",
      "type": "string"
    },
    "raw_scores": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RawScore"
      },
      "title": "Raw Scores",
      "type": "array"
    },
    "selection_reason": {
      "enum": [
        "UNIQUE_VALUE",
        "COMPETING_VALUE",
        "PROFILE_POLICY"
      ],
      "title": "Selection Reason",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "semantic_field",
    "raw_value",
    "normalized_value",
    "selection_reason"
  ],
  "title": "ExtractionCandidate",
  "type": "object"
}
