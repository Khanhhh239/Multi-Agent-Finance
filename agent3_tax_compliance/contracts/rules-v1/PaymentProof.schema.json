    "FieldObject_Annotated_bool__Strict_strict_True___": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "PRESENT"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "value"
            ]
          }
        },
        {
          "else": {
            "properties": {
              "confidence": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "confidence_basis": {
                "const": "CALIBRATED"
              }
            },
            "required": [
              "confidence_basis"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "provenance": {
                "properties": {
                  "calibration_version": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "calibration_version"
                ]
              }
            },
            "required": [
              "confidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "confidence_basis": {
                "const": "DETERMINISTIC"
              }
            },
            "required": [
              "confidence_basis"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "deterministic_policy_version": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "deterministic_policy_version"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confidence_basis": {
                "const": "HUMAN_CONFIRMED"
              }
            },
            "required": [
              "confidence_basis"
            ]
          },
          "then": {
            "properties": {
              "provenance": {
                "properties": {
                  "review_event_id": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "review_event_id"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "boolean"
