        },
        "confidence_basis": {
          "$ref": "#/$defs/ConfidenceBasis",
          "default": "UNAVAILABLE"
        },
        "source": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Source",
          "type": "string"
