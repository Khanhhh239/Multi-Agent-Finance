{
  "$defs": {
    "DerivationManifest": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "derive-v1",
          "default": "derive-v1",
          "title": "Version",
          "type": "string"
        },
        "observed_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observed Sha256",
          "type": "string"
        },
        "master_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Master Sha256",
          "type": "string"
        },
        "relations_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Relations Sha256",
          "type": "string"
        },
        "profile_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Profile Version",
          "type": "string"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/DerivationNode"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "observed_sha256",
        "master_sha256",
        "relations_sha256",
        "profile_version",
        "nodes"
      ],
      "title": "DerivationManifest",
      "type": "object"
    },
    "DerivationNode": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        }
      },
      "required": [
        "path",
        "inputs"
      ],
      "title": "DerivationNode",
      "type": "object"
    },
    "FieldCorrection": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "title": "Field Path",
          "type": "string"
        },
        "before": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before"
        },
        "after": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "string"
            }
          ],
          "title": "After"
        }
      },
      "required": [
        "field_path",
        "before",
        "after"
      ],
      "title": "FieldCorrection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "config_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Config Version",
      "type": "string"
    },
    "creator": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Creator",
      "type": "string"
    },
    "stage": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Stage",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Event Id",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "taxpayer_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Taxpayer Id",
      "type": "string"
    },
    "record_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Record Id",
      "type": "string"
    },
    "actor_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Actor Id",
      "type": "string"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Task Id",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "before_revision": {
      "minimum": 1,
      "title": "Before Revision",
      "type": "integer"
    },
    "after_revision": {
      "minimum": 2,
      "title": "After Revision",
      "type": "integer"
    },
    "before_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Before Sha256",
      "type": "string"
    },
    "after_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "After Sha256",
      "type": "string"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/FieldCorrection"
      },
      "minItems": 1,
      "title": "Changes",
      "type": "array"
    },
    "record_stamp": {
      "additionalProperties": true,
      "title": "Record Stamp",
      "type": "object"
    },
    "derivation": {
      "$ref": "#/$defs/DerivationManifest"
    },
    "affected_nodes": {
      "items": {
        "type": "string"
      },
      "title": "Affected Nodes",
      "type": "array"
    },
    "assessment_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Assessment Id",
      "type": "string"
    },
    "completeness_proof": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Completeness Proof"
    }
  },
  "required": [
    "config_version",
    "creator",
    "stage",
    "event_id",
    "tenant_id",
    "taxpayer_id",
    "record_id",
    "actor_id",
    "task_id",
    "reason",
    "before_revision",
    "after_revision",
    "before_sha256",
    "after_sha256",
    "changes",
    "record_stamp",
    "derivation",
    "affected_nodes",
    "assessment_id",
    "completeness_proof"
  ],
  "title": "CorrectionEvent",
  "type": "object"
}
