{
  "$defs": {
    "ReviewTask": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "config_version": {
          "default": "review-task-v1",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Config Version",
          "type": "string"
        },
        "creator": {
          "default": "review-task-builder",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Creator",
          "type": "string"
        },
        "stage": {
          "default": "review",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Stage",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "taxpayer_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Taxpayer Id",
          "type": "string"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Task Id",
          "type": "string"
        },
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Record Id",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "assessment_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Assessment Id",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "field_path": {
          "title": "Field Path",
          "type": "string"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "status": {
          "enum": [
            "OPEN",
            "RESOLVED",
            "SUPERSEDED",
            "WAITING_DATA",
            "OPERATOR"
          ],
          "title": "Status",
          "type": "string"
        },
        "previous_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "title": "Previous Ids",
          "type": "array"
        }
      },
      "required": [
        "tenant_id",
        "taxpayer_id",
        "task_id",
        "record_id",
        "revision",
        "assessment_id",
        "reason",
        "field_path",
        "action",
        "status",
        "previous_ids"
      ],
      "title": "ReviewTask",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ReviewTask"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    }
  },
  "required": [
    "items",
    "next_cursor"
  ],
  "title": "TaskPage",
  "type": "object"
}
