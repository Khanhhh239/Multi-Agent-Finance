{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 cloud/build_portal_static.py",
  "outputDirectory": "build/portal-static",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'self'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob:; font-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; connect-src 'self' https://*.onrender.com"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/agent4", "destination": "/agent4/index" },
    { "source": "/agent4/", "destination": "/agent4/index" }
  ]
}
