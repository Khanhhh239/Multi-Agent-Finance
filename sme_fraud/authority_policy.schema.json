{
  "version": "phase6",
  "timezone": "+07:00",
  "notes": [
    "The coverage table must declare a complete authority matrix for the covered action and period.",
    "Without active coverage the detector keeps the legacy master-limit or amount-proxy behavior.",
    "Use a new authority_id when the subject, scope, delegation, or effective period changes."
  ],
  "tables": {
    "approval_authority_coverage": {
      "required": ["coverage_id", "company_id", "covered_actions", "covered_from", "covered_through", "status", "evidence_on_file", "evidence_id", "approver_id", "approved_at", "observed_at"],
      "covered_actions": ["self_approve", "approve"],
      "statuses": ["approved", "revoked"]
    },
    "approval_authorities": {
      "required": ["authority_id", "company_id", "subject_employee_id", "subject_role", "action", "txn_type", "department", "project_id", "min_amount_vnd", "max_amount_vnd", "self_approval_allowed", "authority_level", "authority_type", "delegated_by_id", "effective_from", "effective_to", "status", "evidence_on_file", "evidence_id", "approver_id", "approved_at", "observed_at"],
      "actions": ["self_approve", "approve", "all"],
      "authority_levels": ["standard", "high", "executive"],
      "authority_types": ["policy", "delegation"],
      "statuses": ["approved", "revoked"]
    }
  }
}
