{
  "version": "phase4.1",
  "timezone": "+07:00",
  "validation": {
    "contract": "exception_validation.py",
    "mode": "reject_all_malformed_revisions_before_as_of_filtering",
    "boolean_inputs": [0, 1, false, true, "0", "1"],
    "integer_inputs": "Nonnegative native integers excluding booleans, or CSV [0-9]+; number/year/day fields also enforce declared ranges.",
    "time_inputs": "Real canonical dates/timestamps in +07:00 at second precision, ordered intervals and signature/action <= observed_at. Scheduled effective/closing dates may be future.",
    "status_inputs": "Approved sources: approved/revoked/draft/pending/rejected. Other source enums are declared per table in the shared contract. Unknown enums raise ValueError.",
    "missing_proof": "Empty proof/signature fields remain non-authorizing. Validation does not grant approval or alter missing-source scoring policy."
  },
  "common": ["company_id", "observed_at"],
  "approved": ["status", "approver_id", "approved_at", "evidence_on_file", "evidence_id"],
  "tables": {
    "leave_periods": {"approved": true, "fields": ["leave_id", "employee_id", "starts_at", "ends_at"]},
    "system_actions": {"fields": ["action_id", "employee_id", "transaction_id", "action", "action_at", "evidence_id"]},
    "leave_activity_authorizations": {"approved": true, "fields": ["authorization_id", "employee_id", "leave_id", "action", "starts_at", "ends_at"]},
    "employment_events": {"approved": true, "fields": ["employment_event_id", "employee_id", "event_type", "effective_date"]},
    "payroll_settlements": {"approved": true, "fields": ["settlement_id", "employee_id", "transaction_id", "payroll_period", "payment_kind", "service_period_start", "service_period_end", "authorized_amount_vnd"]},
    "workflow_policies": {"approved": true, "fields": ["workflow_policy_id", "control_id", "txn_type", "required", "allow_override", "authorized_override_roles", "override_max_vnd", "effective_from", "effective_to"]},
    "override_events": {"fields": ["override_id", "transaction_id", "actor_id", "operation_at", "control_id", "status", "normal_workflow_completed", "evidence_id"]},
    "document_series": {"approved": true, "fields": ["series_id", "fiscal_year", "document_type", "start_number", "closed_through_number", "closed_at", "cancellation_log_complete"]},
    "document_register": {"fields": ["register_id", "series_id", "document_id", "document_number", "transaction_id", "issued_at", "state", "evidence_id"]},
    "document_cancellations": {"approved": true, "fields": ["cancellation_id", "series_id", "document_id", "document_number"]},
    "receivable_invoices": {"fields": ["invoice_id", "customer_id", "gross_vnd", "issued_at", "due_at", "status", "evidence_id"]},
    "receipt_allocations": {"fields": ["allocation_id", "invoice_id", "customer_id", "receipt_transaction_id", "amount_vnd", "status", "verifier_id", "verified_at", "evidence_id"]},
    "receipt_coverage": {"approved": true, "fields": ["coverage_id", "covered_from", "covered_through"]},
    "receivable_explanations": {"approved": true, "fields": ["explanation_id", "invoice_id", "reason", "effective_from", "expires_at"]}
  }
}
