{
  "version": "phase5.1",
  "timezone": "+07:00",
  "validation": {
    "contract": "exception_validation.py",
    "mode": "reject_before_features_and_scoring",
    "revisions": "Validate and copy every revision, including future/revoked rows; normalize exact CSV/native 0/1 flags and integer amounts before comparing revisions.",
    "timestamps": "Real YYYY-MM-DDTHH:MM:SS+07:00; nonempty approved_at/verified_at must not follow observed_at. Missing proof remains non-authorizing.",
    "scalars": "Reject unknown enums, non-0/1 flags, boolean amounts, floats, negative amounts, NaN/Infinity, malformed dates/times and inverted intervals."
  },
  "notes": [
    "All identifiers are strings and must remain stable across revisions.",
    "Revisions keep the same ID and immutable business binding, with a later observed_at.",
    "Blank optional bindings never act as proof. Numeric bank accounts require recipient_bank_code.",
    "ML features select transaction_documents revisions by observed_at before filtering status; known revocations cannot fall back to final transaction scalars.",
    "Invoice monetary features need invoice_issued_at and an observation timestamp at/before the scoring cutoff. Missing net/VAT/linked VAT stays unknown; never infer these from a later transaction snapshot."
  ],
  "tables": {
    "payment_requests": {
      "required": ["request_id", "company_id", "vendor_id", "purchase_order_id", "contract_id", "invoice_number", "txn_type", "total_vnd", "status", "evidence_on_file", "evidence_id", "approver_id", "approved_at", "observed_at"],
      "optional": ["recipient_account", "recipient_bank_code"],
      "statuses": ["approved", "revoked", "draft", "pending", "rejected"]
    },
    "procurement_links": {
      "required": ["link_id", "company_id", "vendor_id", "transaction_id", "request_id", "purchase_order_id", "status", "evidence_id", "verifier_id", "verified_at", "observed_at"],
      "optional": ["contract_id", "invoice_number"],
      "statuses": ["verified", "revoked", "unverified", "pending", "rejected"]
    },
    "transaction_documents": {
      "required": ["record_id", "company_id", "vendor_id", "transaction_id", "document_type", "status", "evidence_id", "verifier_id", "verified_at", "observed_at"],
      "optional": ["invoice_number", "invoice_gross_vnd", "contract_id", "invoice_id", "invoice_issued_at", "invoice_net_vnd", "invoice_vat_vnd", "linked_input_vat_vnd"],
      "statuses": ["verified", "revoked", "unverified", "pending", "rejected"]
    },
    "supplier_payment_agreements": {
      "required": ["agreement_id", "company_id", "vendor_id", "contract_id", "total_vnd", "status", "evidence_on_file", "evidence_id", "approver_id", "approved_at", "observed_at"],
      "optional": ["invoice_number", "recipient_account", "recipient_bank_code"],
      "statuses": ["approved", "revoked", "draft", "pending", "rejected"]
    },
    "recurring_payments": {
      "required": ["pattern_id", "company_id", "vendor_id", "txn_type", "frequency", "expected_amount_vnd", "tolerance_vnd", "effective_from", "effective_to", "status", "evidence_on_file", "evidence_id", "approver_id", "approved_at", "observed_at"],
      "optional": ["employee_id", "contract_id", "invoice_number", "recipient_account", "recipient_bank_code", "allow_partial"],
      "frequencies": ["weekly", "monthly", "quarterly", "yearly"],
      "statuses": ["approved", "revoked", "draft", "pending", "rejected"]
    },
    "vendor_payment_schedules": {
      "required": ["schedule_id", "company_id", "vendor_id", "txn_type", "schedule_type", "window_start_mmdd", "window_end_mmdd", "expected_amount_vnd", "tolerance_vnd", "allow_partial", "effective_from", "effective_to", "status", "evidence_on_file", "evidence_id", "approver_id", "approved_at", "observed_at"],
      "optional": ["contract_id", "invoice_number", "recipient_account", "recipient_bank_code"],
      "schedule_types": ["annual", "seasonal"],
      "statuses": ["approved", "revoked", "draft", "pending", "rejected"]
    }
  }
}
