{$PORTAL_HOST} {
	encode zstd gzip

	# Agent 2 training station: operator-only, so it sits behind its own login.
	redir /station /station/
	handle_path /station/* {
		basic_auth {
			{$STATION_USER} {$STATION_PASSWORD_HASH}
		}
		reverse_proxy maf-demo:8890
	}

	# Everything else on the Portal host (Portal, Agent 2, Agent 4) needs the shared reviewer login, so strangers
	# cannot read the demo data, stop agents or spend the API quota. Agent 1 and Agent 3 keep their own hosts
	# without it because the Portal shows them in iframes; they hold synthetic data only.
	handle {
		basic_auth {
			{$SITE_USER} {$SITE_PASSWORD_HASH}
		}
		reverse_proxy maf-demo:8800
	}
}

{$AGENT1_HOST} {
	encode zstd gzip
	reverse_proxy maf-demo:8011
}

{$AGENT3_HOST} {
	encode zstd gzip
	reverse_proxy maf-demo:8640
}
