# Three DNS A records must point to the VM's public IP.
PORTAL_HOST=portal.example.com
AGENT1_HOST=agent1.example.com
AGENT3_HOST=agent3.example.com

# Login for the Agent 2 training station at https://<PORTAL_HOST>/station/.
# Create the hash with:  docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains '$' characters.
STATION_USER=station
STATION_PASSWORD_HASH='$2a$14$replace-with-the-output-of-caddy-hash-password'

# Set these to the Linux account that owns deploy/azure-vm/state.
MAF_UID=1000
MAF_GID=1000

# Agent 3 and Agent 4 need provider credentials to answer interactive requests.
AGENT3_LLM_API_KEY=
AGENT3_EMBED_API_KEY=
AGENT4_LLM_API_KEY=
AGENT4_EMBED_API_KEY=
