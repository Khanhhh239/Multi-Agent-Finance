{
  "port": 8800,
  "workspace": "/state/portal",
  "demo_company": null,
  "agents": {
    "agent1": {
      "root": "/app/agent1",
      "port": 8011,
      "storage_root": "/state/agent1"
    },
    "agent2": {
      "root": "/app/agent2",
      "python": "/app/agent2/.he-venv/bin/python",
      "port": 8766,
      "snapshot_db": "/state/agent2/snapshots-v2.sqlite3",
      "model_db": "/state/agent2/models-v2.sqlite3",
      "analysis_bindings": "/state/agent2/analysis-bindings.json",
      "access_file": "/state/portal/agent2_access.json",
      "env": {
        "AGENT2_CASE_QUEUE_DB": "/state/agent2/case-queue.sqlite3",
        "AGENT2_REMEDIATION_DB": "/state/agent2/remediation.sqlite3",
        "AGENT2_WORKSPACE_DIR": "/state/agent2/workspace",
        "AGENT2_STATION_SECRET_FILE": "/state/agent2/station-secret.txt",
        "AGENT2_RELEASE_CONFIG": "/state/agent2/release-runtime.json",
        "AGENT2_HE_PYTHON": "/app/agent2/.he-venv/bin/python"
      }
    },
    "agent3": {
      "root": "/app/agent3/agent3_tax_compliance",
      "port": 8640,
      "env": {
        "AGENT3_WORKSPACES": "/state/agent3/workspaces",
        "AGENT3_ADMIN_STORE": "/state/agent3/admin.json",
        "AGENT3_LAW_DB": "/state/agent3/legal_corpus.sqlite3",
        "AGENT3_LAW_CACHE": "/state/agent3/law-cache"
      }
    },
    "agent4": {
      "root": "/app/agent4",
      "port": 8040,
      "env": {
        "AGENT4_DB_PATH": "/state/demo/warehouse.duckdb",
        "AGENT4_SELECTION_CONFIG": "/app/agent4/config/selection.yaml"
      }
    }
  }
}
