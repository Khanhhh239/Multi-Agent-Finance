{
  "$defs": {
    "ErrorData": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorData",
      "type": "object"
    },
    "Interpretation": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "items": {
            "type": "string"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "metric_ids": {
          "items": {
            "type": "string"
          },
          "title": "Metric Ids",
          "type": "array"
        },
        "time": {
          "$ref": "#/$defs/TimeDraft"
        },
        "view": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "View"
        }
      },
      "required": [
        "metric_ids",
        "dimensions",
        "view",
        "time"
      ],
      "title": "Interpretation",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "catalog_hash": {
          "title": "Catalog Hash",
          "type": "string"
        },
        "data_watermark": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Data Watermark"
        },
        "query_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Query Fingerprint"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "catalog_hash",
        "data_watermark",
        "source",
        "query_fingerprint"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ResultColumn": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "type": {
          "enum": [
            "date",
            "string",
            "decimal",
            "integer",
            "boolean"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "key",
        "type"
      ],
      "title": "ResultColumn",
      "type": "object"
    },
    "ResultData": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/ResultColumn"
          },
          "title": "Columns",
          "type": "array"
        },
        "row_count": {
          "title": "Row Count",
          "type": "integer"
        },
        "rows": {
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object"
          },
          "title": "Rows",
          "type": "array"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "columns",
        "rows",
        "row_count",
        "truncated"
      ],
      "title": "ResultData",
      "type": "object"
    },
    "TimeDraft": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "As Of"
        },
        "end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "End"
        },
        "grain": {
          "anyOf": [
            {
              "enum": [
                "day",
                "week",
                "month",
                "quarter",
                "year"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Grain"
        },
        "mode": {
          "enum": [
            "range",
            "as_of",
            "none"
          ],
          "title": "Mode",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Start"
        }
      },
      "required": [
        "mode",
        "start",
        "end",
        "as_of",
        "grain"
      ],
      "title": "TimeDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "api_version": {
      "const": "v1",
      "title": "Api Version",
      "type": "string"
    },
    "data": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResultData"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorData"
        },
        {
          "type": "null"
        }
      ]
    },
    "interpretation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Interpretation"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "needs_clarification",
        "unsupported",
        "forbidden",
        "no_data",
        "temporarily_unavailable",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "api_version",
    "request_id",
    "status",
    "error",
    "answer",
    "data",
    "interpretation",
    "provenance",
    "warnings"
  ],
  "title": "QueryResponse",
  "type": "object"
}
