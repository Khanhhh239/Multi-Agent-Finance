# =====================================================================
# Sổ Son: file cấu hình DUY NHẤT của cả dự án.
# Chép thành .env (cùng thư mục gốc), điền key; .env không được đưa lên git.
#   - Chạy local (run_web.ps1 / run_web.bat): Portal đọc file này khi bật Agent 3 và Agent 4.
#   - Chạy Agent 3 riêng (chay_agent3.bat): Agent 3 cũng đọc file này.
#   - Azure VM: cd deploy/azure-vm && docker compose --env-file ../../.env -f compose.yaml up -d
# =====================================================================

# ---------- Agent 3: Tuân thủ thuế GTGT ----------
AGENT3_LLM_API_KEY=
# Embedding chạy local bằng Ollama (https://ollama.com, lệnh: ollama pull bge-m3:567m); Ollama bỏ qua key nhưng
# Agent 3 và Agent 4 cần một giá trị khác rỗng. Trên Azure VM, compose.yaml tự trỏ sang dịch vụ ollama của nó.
AGENT3_EMBED_API_KEY=ollama
# Cohere reranker cho tìm kiếm luật (để trống thì bỏ qua bước rerank).
AGENT3_RERANK_API_KEY=
AGENT3_LLM_PROVIDER=openai
AGENT3_LLM_BASE_URL=https://api.groq.com/openai/v1
AGENT3_LLM_MODEL=qwen/qwen3.8-27b
AGENT3_LLM_ENABLE_THINKING=0
AGENT3_LLM_NUM_CTX=32768
AGENT3_EMBED_PROVIDER=openai
AGENT3_EMBED_BASE_URL=http://127.0.0.1:11434/v1
# Đổi model embedding sẽ làm Agent 3 xóa và embed lại toàn bộ kho luật. Phải trùng model trong deploy/azure-vm/compose.yaml.
AGENT3_EMBED_MODEL=bge-m3:567m
AGENT3_RERANK_PROVIDER=cohere
AGENT3_RERANK_URL=https://api.cohere.com/v2/rerank
AGENT3_RERANK_MODEL=rerank-v5.0-pro
# Mật khẩu cố định của trang Quản trị Agent 3 (ít nhất 8 ký tự), ghi lại mỗi lần khởi động.
# Để trống chỉ khi chạy trên máy riêng: khi đó người mở trang đầu tiên sẽ đặt mật khẩu.
AGENT3_ADMIN_PASSWORD=

# ---------- Agent 4: Trợ lý CFO & Sổ cái ----------
# Agent 4 cần đủ cả hai key, thiếu thì không khởi động.
AGENT4_LLM_API_KEY=
AGENT4_EMBED_API_KEY=ollama
AGENT4_EMBED_BASE_URL=http://127.0.0.1:11434/v1
AGENT4_EMBED_MODEL=bge-m3:567m
AGENT4_EMBED_DIMENSIONS=1024
# Chỉ dùng khi chạy Agent 4 riêng (không qua Portal); Portal tự sinh token.
AGENT4_DEMO_TOKEN=replace-with-local-secret
AGENT4_AS_OF=2026-10-14
AGENT4_LAST_CLOSED_MONTH=2026-08

# ---------- Chỉ dùng khi deploy Azure VM (local bỏ qua) ----------
# Ba bản ghi DNS A trỏ về IP public của VM.
PORTAL_HOST=portal.example.com
AGENT1_HOST=agent1.example.com
AGENT3_HOST=agent3.example.com
# Đăng nhập máy trạm huấn luyện Agent 2 tại https://<PORTAL_HOST>/station/.
# Tạo hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'mat-khau'
# Giữ nguyên dấu nháy đơn: hash có ký tự '$'.
STATION_USER=station
STATION_PASSWORD_HASH='$2a$14$replace-with-the-output-of-caddy-hash-password'
# Tài khoản Linux sở hữu deploy/azure-vm/state (lệnh: id -u ; id -g).
MAF_UID=1000
MAF_GID=1000
# Đăng nhập chung cho cả trang Portal trên VM (gửi riêng cho BTC). Hash tạo như STATION_PASSWORD_HASH.
SITE_USER=bantochuc
SITE_PASSWORD_HASH='$2a$14$replace-with-the-output-of-caddy-hash-password'
