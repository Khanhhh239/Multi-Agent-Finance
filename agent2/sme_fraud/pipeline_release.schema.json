{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"pipeline-release-bundle/1.1.0",
  "type":"object","additionalProperties":false,
  "required":["version","name","score_semantics","components","tenant_id","company_id","profile","qualification_snapshot","created_at","created_by"],
  "properties":{
    "version":{"enum":["pipeline-release-bundle/1.0.0","pipeline-release-bundle/1.1.0"]},
    "name":{"type":"string","minLength":1,"maxLength":160},
    "tenant_id":{"type":"string","minLength":1},"company_id":{"type":"string","minLength":1},
    "profile":{"enum":["snapshot_detector_shadow/1.0.0","snapshot_case_shadow/1.0.0"]},
    "created_at":{"type":"string","format":"date-time"},"created_by":{"type":"string","minLength":1},
    "qualification_snapshot":{"type":"object","additionalProperties":false,"required":["snapshot_id","checksum","data_checksum","contract_version"],"properties":{
      "snapshot_id":{"type":"string","pattern":"^snp_[a-f0-9]{32}$"},
      "checksum":{"type":"string","pattern":"^[a-f0-9]{64}$"},"data_checksum":{"type":"string","pattern":"^[a-f0-9]{64}$"},"contract_version":{"type":"string"}}},
    "score_semantics":{"enum":["ranking_only","calibrated_probability"]},
    "components":{
      "type":"object","additionalProperties":false,
      "required":["rules","graph","feature_contract","preprocess","models","reference","normalization","calibration","ensemble","fallback","grouping","thresholds","budget","mandatory_routing","backlog","documents","runtime","he"],
      "properties":{
        "rules":{"$ref":"#/$defs/component"},"feature_contract":{"$ref":"#/$defs/component"},
        "graph":{"$ref":"#/$defs/component"},
        "validation_study":{"$ref":"#/$defs/component"},
        "preprocess":{"$ref":"#/$defs/component"},"models":{"$ref":"#/$defs/component"},
        "reference":{"$ref":"#/$defs/component"},"normalization":{"$ref":"#/$defs/component"},
        "calibration":{"$ref":"#/$defs/component"},"ensemble":{"$ref":"#/$defs/component"},
        "fallback":{"$ref":"#/$defs/component"},"grouping":{"$ref":"#/$defs/component"},
        "thresholds":{"$ref":"#/$defs/component"},"budget":{"$ref":"#/$defs/component"},
        "mandatory_routing":{"$ref":"#/$defs/component"},"backlog":{"$ref":"#/$defs/component"},
        "documents":{"$ref":"#/$defs/component"},"runtime":{"$ref":"#/$defs/component"},"he":{"$ref":"#/$defs/component"}
      }
    }
  },
  "allOf":[{"if":{"properties":{"version":{"const":"pipeline-release-bundle/1.1.0"}}},"then":{"properties":{"profile":{"const":"snapshot_case_shadow/1.0.0"},"components":{"required":["validation_study"]}}},"else":{"properties":{"profile":{"const":"snapshot_detector_shadow/1.0.0"},"components":{"not":{"required":["validation_study"]}}}}}],
  "$defs":{
    "component":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["artifact_id"],"properties":{"artifact_id":{"type":"string","pattern":"^rart_[a-f0-9]{64}$"}}},
      {"type":"object","additionalProperties":false,"required":["unused","reason"],"properties":{"unused":{"const":true},"reason":{"type":"string","minLength":10,"maxLength":600}}}
    ]}
  }
}
