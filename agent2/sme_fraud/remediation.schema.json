            "waiting_evidence": {"type": "integer", "minimum": 0},
            "closed": {"type": "integer", "minimum": 0}
          }
        },
        "task_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_tasks",
            "open",
            "in_progress",
            "waiting_external",
            "completed",
            "cancelled",
            "overdue",
            "due_soon",
            "awaiting_confirmation"
          ],
          "properties": {
            "total_tasks": {"type": "integer", "minimum": 0},
            "open": {"type": "integer", "minimum": 0},
            "in_progress": {"type": "integer", "minimum": 0},
            "waiting_external": {"type": "integer", "minimum": 0},
            "completed": {"type": "integer", "minimum": 0},
            "cancelled": {"type": "integer", "minimum": 0},
            "overdue": {"type": "integer", "minimum": 0},
            "due_soon": {"type": "integer", "minimum": 0},
            "awaiting_confirmation": {"type": "integer", "minimum": 0}
          }
        },
        "document_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checklists_evaluated",
            "incomplete_checklists",
            "incomplete_rate",
            "total_documents",
            "pending_verification_docs",
            "verified_docs",
            "rejected_docs",
            "missing_items",
            "unknown_items"
          ],
          "properties": {
            "checklists_evaluated": {"type": "integer", "minimum": 0},
            "incomplete_checklists": {"type": "integer", "minimum": 0},
            "incomplete_rate": {"type": "number", "minimum": 0.0, "maximum": 1.0},
            "total_documents": {"type": "integer", "minimum": 0},
            "pending_verification_docs": {"type": "integer", "minimum": 0},
            "verified_docs": {"type": "integer", "minimum": 0},
            "rejected_docs": {"type": "integer", "minimum": 0},
            "missing_items": {"type": "integer", "minimum": 0},
            "unknown_items": {"type": "integer", "minimum": 0}
          }
        },
        "timings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "avg_task_processing_hours",
            "avg_waiting_evidence_hours",
            "completed_tasks_timed"
          ],
          "properties": {
            "avg_task_processing_hours": {
              "anyOf": [
                {"type": "number", "minimum": 0.0},
                {"type": "null"}
              ]
            },
            "avg_waiting_evidence_hours": {
              "anyOf": [
                {"type": "number", "minimum": 0.0},
                {"type": "null"}
              ]
            },
            "completed_tasks_timed": {"type": "integer", "minimum": 0}
          }
        },
        "amounts_vnd": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "related_amount_vnd",
            "discrepancy_amount_vnd",
            "confirmed_loss_vnd",
            "recovered_vnd",
            "deduplicated_obligation_count"
          ],
          "properties": {
            "related_amount_vnd": {"$ref": "#/$defs/nullable_nonneg_int"},
            "discrepancy_amount_vnd": {"$ref": "#/$defs/nullable_nonneg_int"},
            "confirmed_loss_vnd": {"$ref": "#/$defs/nullable_nonneg_int"},
            "recovered_vnd": {"$ref": "#/$defs/nullable_nonneg_int"},
            "deduplicated_obligation_count": {"type": "integer", "minimum": 0}
          }
        },
        "by_issue_type": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tasks", "open_tasks", "completed_tasks", "related_amount_vnd"],
            "properties": {
              "tasks": {"type": "integer", "minimum": 0},
              "open_tasks": {"type": "integer", "minimum": 0},
              "completed_tasks": {"type": "integer", "minimum": 0},
              "related_amount_vnd": {"$ref": "#/$defs/nullable_nonneg_int"}
            }
          }
        }
      }
    }
